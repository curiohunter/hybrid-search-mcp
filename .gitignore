__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
.env
.env.*
*.lock
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Machine-local runtime state — never commit
.hybrid-search/
.codex/

# PoC embedding cache — derived from conversation content, regenerated on run
scripts/.poc_cache/
.hybrid-search/runtime/

# Generated per machine by `setup --codex` — the manifest embeds absolute
# interpreter paths, so it is local configuration, not something to ship.
.codex-plugin/

# hybrid-search-mcp (auto-added — wiki is machine-local)
.hybrid-search/wiki/
.hybrid-search/wiki-gaps.*
.hybrid-search/coverage.json
.hybrid-search/.reindex.lock
.hybrid-search/.gaps-shown
.hybrid-search/needs_synthesis
.hybrid-search/qa/
.hybrid-search/qa-archive/

# Benchmark gold sets and results quote a project's own corpus — class names,
# vendors, verbatim user prompts. The runners are shared; what they measure
# stays with the project being measured.
benchmarks/conv_gold.json
benchmarks/conv_results_*.json
benchmarks/replay_pre_*.json
benchmarks/replay_post_*.json
benchmarks/router_calibration/*_augmented.json
