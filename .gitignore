__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
.env
.env.*
*.lock
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Machine-local runtime state — never commit
.hybrid-search/
.codex/

# PoC embedding cache — derived from conversation content, regenerated on run
scripts/.poc_cache/
.hybrid-search/runtime/

# Generated per machine by `setup --codex` — the manifest embeds absolute
# interpreter paths, so it is local configuration, not something to ship.
.codex-plugin/

# hybrid-search-mcp (auto-added — wiki is machine-local)
.hybrid-search/wiki/
.hybrid-search/wiki-gaps.*
.hybrid-search/coverage.json
.hybrid-search/.reindex.lock
.hybrid-search/.gaps-shown
.hybrid-search/needs_synthesis
.hybrid-search/qa/
.hybrid-search/qa-archive/

# Benchmark result artifacts quote the corpus they measured — file paths that
# name real schools, classes and internal document trees. Runners and gold
# sets that carry no such quotation stay; outputs do not.
benchmarks/**/valuein_*.json
benchmarks/**/raw_*.json
benchmarks/**/compounding_*.json
benchmarks/**/results_v2.json
benchmarks/memory_bench_v2_valuein_*.json
