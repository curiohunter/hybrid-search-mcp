# Machine-local runtime state — never commit
.hybrid-search/
.codex/

# PoC embedding cache — derived from conversation content, regenerated on run
scripts/.poc_cache/
.hybrid-search/runtime/

# Generated per machine by `setup --codex` — the manifest embeds absolute
# interpreter paths, so it is local configuration, not something to ship.
.codex-plugin/

# hybrid-search-mcp (auto-added — wiki is machine-local)
.hybrid-search/wiki/
.hybrid-search/wiki-gaps.*
.hybrid-search/coverage.json
.hybrid-search/.reindex.lock
.hybrid-search/.gaps-shown
.hybrid-search/needs_synthesis
.hybrid-search/qa/
.hybrid-search/qa-archive/

# Benchmark gold sets and results quote the corpus they measured — paths that
# name real institutions and classes, internal document trees, verbatim user
# prompts. The runners are shared; what they measure stays with the project
# being measured. See CLAUDE.md, "공개물에 코퍼스를 인용하지 말 것".
benchmarks/conv_gold.json
benchmarks/conv_results_*.json
benchmarks/replay_pre_*.json
benchmarks/replay_post_*.json
benchmarks/router_calibration/*_augmented.json
benchmarks/**/valuein_*.json
benchmarks/**/raw_*.json
benchmarks/**/compounding_*.json
benchmarks/**/results_v2.json
benchmarks/memory_bench_v2_valuein_*.json
# Tracked before the rule above existed, untracked 2026-09-23 — each quotes
# the dogfood corpus: its file paths, the questions its user typed.
benchmarks/router_gold.json
benchmarks/query_set.json
benchmarks/memory_bench_v2_cases.json
benchmarks/round3_rerun/calibration_rows_*.jsonl
benchmarks/authority_poc/external_queries.json
benchmarks/agent_loop_*.json
